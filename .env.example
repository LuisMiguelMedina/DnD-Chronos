# Discord. En el portal de desarrolladores activa Message Content Intent.
DISCORD_TOKEN=
# Opcional. Si lo defines, los comandos se registran solo en ese servidor.
DISCORD_GUILD_ID=

# gemini usa la API de Google. session usa un token de un proveedor privado.
AI_PROVIDER=gemini

# Crea la clave en Google AI Studio (restringida a Gemini API).
# Google AI Pro: vincula el crédito mensual en https://aistudio.google.com/learn/use-google-ai-plan-credits-in-ai-studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# LOW, MEDIUM o HIGH. El cronista usa HIGH por defecto (más lento, mejor en sesiones largas).
GEMINI_THINKING_LEVEL=HIGH
# Solo si apuntas el SDK de Gemini a una pasarela compatible.
GEMINI_BASE_URL=

# AI_PROVIDER=session. openai habla /chat/completions; chronicle habla /v1/chronicle.
AI_BASE_URL=
AI_SESSION_TOKEN=
AI_MODEL=
AI_SESSION_API_STYLE=openai
AI_TIMEOUT_SECONDS=300

# Ruta local del vault cuando corres el bot sin Docker.
OBSIDIAN_VAULT_PATH=./vault
# Ruta del host que docker-compose monta en /vault. Tiene que existir.
OBSIDIAN_VAULT_HOST_PATH=/ruta/al/vault

DATABASE_PATH=./data/state.db
CAMPAIGN_NAME=Campaña
CHRONICLER_TIMEZONE=America/Mexico_City
# Canales donde un audio se procesa aunque no mencionen al bot. Ids separados por comas.
WATCH_CHANNEL_IDS=
MAX_MEDIA_BYTES=26214400
INLINE_MEDIA_BYTES=15728640

VAULT_DIR_NPCS=NPCs
VAULT_DIR_LOCATIONS=Lugares
VAULT_DIR_SESSIONS=Sesiones
VAULT_DIR_ITEMS=Objetos
VAULT_DIR_FACTIONS=Facciones
VAULT_DIR_PLOTS=Tramas
