# Discord
DISCORD_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=optional_for_dev_slash_sync

# Gemini (recommended: free-tier API key)
GEMINI_API_KEY=your_gemini_api_key
# Optional: override base URL for private/session-token gateways
# GEMINI_API_BASE_URL=
# GEMINI_SESSION_TOKEN=

GEMINI_MODEL=gemini-2.0-flash

# Obsidian vault (host path mounted in docker-compose)
OBSIDIAN_VAULT_PATH=/vault
OBSIDIAN_FOLDER_NPCS=NPCs
OBSIDIAN_FOLDER_PLACES=Lugares
OBSIDIAN_FOLDER_SESSIONS=Sesiones

# SQLite state cache
DATABASE_PATH=/data/chronicler.db
